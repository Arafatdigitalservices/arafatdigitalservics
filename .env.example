# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled later).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional: Leave empty to use built-in local server storage,
# or fill with your Supabase project credentials to connect to Supabase PostgreSQL & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Authentication Override (Optional: If omitted, the first visitor to /admin
# can claim the admin account via the one-time First-Run Setup form)
ADMIN_PASSWORD=
