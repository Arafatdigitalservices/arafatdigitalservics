# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled later).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Required for Supabase PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server Session Signing Secret (Recommended for production/Vercel, >= 32 random chars)
SESSION_SECRET=

# Optional RBAC Owner Email Lock (If set, first-run admin setup only permits this email)
ADMIN_OWNER_EMAIL=

# Optional Admin Password Override (Leave empty to use Supabase Auth RBAC + profiles.role = 'admin')
ADMIN_PASSWORD=

